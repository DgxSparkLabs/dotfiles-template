#!/bin/sh
# dotfiles_githooks launcher (POSIX; Git for Windows uses sh.exe). LF line endings only.
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
if [ -z "${HOME:-}" ]; then
  echo "dotfiles_githooks: HOME is unset; refusing to run uv (would create a project-local .venv)." >&2
  exit 1
fi
export UV_PROJECT_ENVIRONMENT="$HOME/.cache/dotfiles/githooks-runner"
exec uv run --project "$ROOT/githooks-runner" python -m dotfiles_githooks "$(basename "$0")" "$@"
