/*
!.gitignore

# Parents must be re-included one level at a time or Git will not see the tool tree.
!.local/
.local/*
!.local/share/
.local/share/*
!.local/share/dotfiles/

# Defensive: never track these even if explicitly added
.ssh/id_*
.ssh/*_rsa
.ssh/*_ed25519
.ssh/known_hosts
.netrc
.aws/credentials
.env
.env.*
*.pem
*.key
