# POSIX bootstrap script must stay LF for Git-Bash/sh on Windows.
bootstrap.sh text eol=lf
# POSIX hook stubs must stay LF for Git-Bash/sh on Windows.
.githooks/* text eol=lf
# POSIX shell scripts must stay LF so bash/sh on Windows can run them.
dotfiles-doctor.sh text eol=lf
githooks-runner/**/*.py text eol=lf
githooks-runner/pyproject.toml text eol=lf
githooks-runner/uv.lock text eol=lf
dotfiles-update.sh text eol=lf

# POSIX-ish completion scripts must stay LF for bash/zsh on Windows.
completions/*.bash text eol=lf
completions/*.zsh text eol=lf
